{
  "manifest_version": 1,
  "type": "device",
  "name": "Tankerkönig",
  "description": {
    "en": "Unofficial connector: German fuel prices per station, cheapest nearby and price alerts.",
    "fr": "Connecteur non officiel : prix des carburants en Allemagne, station la moins chère, alertes."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-tankerkoenig:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-tankerkoenig/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Fuel prices in Germany",
        "fr": "Les prix des carburants en Allemagne"
      },
      "description": {
        "en": "Unofficial connector, not affiliated with Tankerkönig. It reads the Tankerkönig open data API (the prices every German station reports to the MTS-K, licensed CC BY 4.0): one device per watched station with its Super E5, Super E10 and Diesel prices and whether it is open, a \"Cheapest nearby\" device, scene triggers when a price goes below a threshold, drops, or the cheapest station changes, a scene action and a widget. Request a free personal API key (link below) and paste it here: the stations around your house are then suggested in Discovery.",
        "fr": "Connecteur non officiel, sans lien avec Tankerkönig. Il lit l'API ouverte de Tankerkönig (les prix que chaque station allemande déclare à la MTS-K, sous licence CC BY 4.0) : un appareil par station suivie avec ses prix Super E5, Super E10 et Diesel et son ouverture, un appareil « Le moins cher à proximité », des déclencheurs quand un prix passe sous un seuil, baisse, ou que la station la moins chère change, une action de scène et un widget. Demandez une clé d'API personnelle gratuite (lien ci-dessous) et collez-la ici : les stations autour de votre maison sont alors proposées dans Découverte."
      },
      "links": [
        {
          "url": "https://onboarding.tankerkoenig.de/",
          "label": {
            "en": "Request a free API key",
            "fr": "Demander une clé d'API gratuite"
          }
        },
        {
          "url": "https://creativecommons.tankerkoenig.de/",
          "label": {
            "en": "Tankerkönig API and terms of use (German)",
            "fr": "API et conditions d'utilisation de Tankerkönig (allemand)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-tankerkoenig/blob/main/docs/fr.md",
          "label": {
            "en": "Guide (French)",
            "fr": "Guide (français)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-tankerkoenig/blob/main/docs/en.md",
          "label": {
            "en": "Guide (English)",
            "fr": "Guide (anglais)"
          }
        }
      ]
    },
    {
      "key": "api_key",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Tankerkönig API key",
        "fr": "Clé d'API Tankerkönig"
      },
      "description": {
        "en": "Stored encrypted by Gladys and only sent to creativecommons.tankerkoenig.de.",
        "fr": "Stockée chiffrée par Gladys et envoyée uniquement à creativecommons.tankerkoenig.de."
      },
      "placeholder": {
        "en": "00000000-0000-0000-0000-000000000000",
        "fr": "00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "key": "fuels",
      "type": "multi_select",
      "required": false,
      "default": ["e5", "e10", "diesel"],
      "label": {
        "en": "Fuels to track",
        "fr": "Carburants à suivre"
      },
      "description": {
        "en": "One price feature per fuel on each station (when the station sells it). None checked: all three.",
        "fr": "Une fonctionnalité de prix par carburant sur chaque station (si elle le vend). Aucun coché : les trois."
      },
      "options": [
        {
          "value": "e5",
          "label": {
            "en": "Super E5",
            "fr": "Super E5"
          }
        },
        {
          "value": "e10",
          "label": {
            "en": "Super E10",
            "fr": "Super E10"
          }
        },
        {
          "value": "diesel",
          "label": {
            "en": "Diesel",
            "fr": "Gazole (diesel)"
          }
        }
      ]
    },
    {
      "key": "radius",
      "type": "number",
      "required": false,
      "default": 5,
      "min": 1,
      "max": 25,
      "label": {
        "en": "Radius around the house (km)",
        "fr": "Rayon autour de la maison (km)"
      },
      "description": {
        "en": "The stations within this distance are suggested in Discovery (25 nearest at most), and the \"Cheapest station nearby\" action searches there by default. Tankerkönig allows 25 km at most.",
        "fr": "Les stations à cette distance sont proposées dans Découverte (les 25 plus proches au plus), et l'action « Station la moins chère à proximité » cherche là par défaut. Tankerkönig autorise 25 km au plus."
      }
    },
    {
      "key": "stations",
      "type": "string",
      "required": false,
      "label": {
        "en": "Other stations (ids)",
        "fr": "Autres stations (identifiants)"
      },
      "description": {
        "en": "Tankerkönig station ids, separated by commas, with an optional custom name after : — the \"Search stations\" button gives the ids.",
        "fr": "Identifiants de stations Tankerkönig, séparés par des virgules, avec un nom personnalisé facultatif après : — le bouton « Chercher des stations » donne les identifiants."
      },
      "placeholder": {
        "en": "278130b1-e062-4a0f-80cc-19e486b4c024:Aral near work",
        "fr": "278130b1-e062-4a0f-80cc-19e486b4c024:Aral du bureau"
      }
    },
    {
      "key": "poll_interval",
      "type": "number",
      "required": false,
      "default": 10,
      "min": 5,
      "max": 60,
      "label": {
        "en": "Refresh interval (min)",
        "fr": "Intervalle de rafraîchissement (min)"
      },
      "description": {
        "en": "How often the prices of the watched stations are read (10 per request). Tankerkönig asks home automation for 5 minutes at least.",
        "fr": "Fréquence de lecture des prix des stations suivies (10 par requête). Tankerkönig demande au moins 5 minutes aux systèmes domotiques."
      }
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Test the API key",
        "fr": "Tester la clé d'API"
      },
      "description": {
        "en": "Sends one price request to Tankerkönig and checks the house location and the typed ids.",
        "fr": "Envoie une requête de prix à Tankerkönig et vérifie la position de la maison et les identifiants saisis."
      }
    },
    {
      "key": "search_stations",
      "timeout_seconds": 30,
      "label": {
        "en": "Search stations",
        "fr": "Chercher des stations"
      },
      "description": {
        "en": "Lists the stations around the house whose name, brand, street, town or postcode contains the text, with their id.",
        "fr": "Liste les stations autour de la maison dont le nom, la marque, la rue, la ville ou le code postal contient le texte, avec leur identifiant."
      },
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": false,
          "label": {
            "en": "Text (empty: the nearest)",
            "fr": "Texte (vide : les plus proches)"
          },
          "placeholder": {
            "en": "Aral",
            "fr": "Aral"
          }
        },
        {
          "key": "radius",
          "type": "number",
          "required": false,
          "default": 10,
          "min": 1,
          "max": 25,
          "label": {
            "en": "Radius (km)",
            "fr": "Rayon (km)"
          }
        }
      ]
    }
  ],
