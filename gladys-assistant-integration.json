    {
      "key": "fuel_prices",
      "label": {
        "en": "Fuel prices",
        "fr": "Prix des carburants"
      },
      "description": {
        "en": "The cheapest price per fuel and the watched stations with their prices, the cheapest in green.",
        "fr": "Le prix le plus bas par carburant et les stations suivies avec leurs prix, la moins chère en vert."
      },
      "icon": "droplet",
      "settings": [
        {
          "key": "fuel",
          "type": "select",
          "required": false,
          "label": {
            "en": "Fuel (empty: every tracked fuel)",
            "fr": "Carburant (vide : tous ceux suivis)"
          },
          "options": [
